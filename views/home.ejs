<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog app</title>
    <style>
        Reset
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #333;
    background-color: #f9f9f9;
    margin: 0;
    
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
}

.header {
    background-color: #f8f9fa; /* Optional: Light background */
    padding: 10px 20px;
}

.container {
    display: flex;
    align-items: center; /* Align items vertically in the center */
    justify-content: space-between; /* Space between logo and nav links */
}

.logo img {
    height: 40px; /* Adjust the logo size */
}

.nav {
    display: flex; /* Display links inline */
    gap: 20px; /* Add space between links */
}

.nav a {
    text-decoration: none;
    color: #333; /* Default link color */
    font-weight: bold;
}

.nav a:hover {
    color: #007bff; 
}
.profile img {
    height: 40px; 
    border-radius: 50%; 
    cursor: pointer;
} 

.profile img:hover {
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.3); 
}


.main-content {
    padding: 2rem 0;
    background: #f5f5f5;
    background-image: url('https://th.bing.com/th/id/OIP.4ATGbCtdHqNp8ClHCOU80wHaEJ?w=284&h=180&c=7&r=0&o=5&dpr=1.3&pid=1.7'); /* Add this line */
}

.featured-post {
    text-align: center;
    margin-bottom: 2rem;
}

.featured-title {
    font-size: 2.5rem;
    color: #141313;
    margin-bottom: 1rem;
    font-style:var();
    font-family: Verdana, Geneva, Tahoma, sans-serif ;
}

.featured-description {
    font-size: 1.2rem;
    margin-bottom: 1rem;
    color: #0c0707;
    text-decoration: solid;
    font-family: 'Courier New', Courier, monospace;
}



.read-more:hover {
    background: #555;
}



.recent-posts {
    margin-top: 2rem;
    font-family:'Courier New', Courier, monospace;
}

.recent-posts h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    text-align: center;
}

.post-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
}

.post {
    background: #fff;
    padding: 1rem;
    border: 1px solid #ddd;
    border-radius: 5px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    text-align: center;
}

.post-title a {
    color: #333;
    font-size: 1.5rem;
    text-decoration: none;
}

.post-title a:hover {
    color: #000;
}

.post-excerpt {
    color: #666;
    margin-top: 0.5rem;
}


.footer {
    background: #333;
    color: #fff;
    text-align: center;
    padding: 1rem 0;
    margin-top: 2rem;
}


    </style>
</head>
<body>
    <header class="header">
        <div class="container">
            <div class="logo">
                <img src="https://th.bing.com/th?id=OIP.fXktcQxAb0ahw5VZwNk_GgHaHa&w=250&h=250&c=8&rs=1&qlt=90&o=6&dpr=1.3&pid=3.1&rm=2" alt="my blog logo">
            </div>
            <nav class="nav centered">
                <a href="#">Home</a>
                <a href="/blog/createmyBlog">MyBlog</a>
                <a href="#">Categories</a>
                <a href="#">Contact</a>
            </nav>
            <div class="profile">
                <a href="/user/profile">
                <img src="https://th.bing.com/th?id=OIP.bJpr9jpclIkXQT-hkkb1KQHaHa&w=250&h=250&c=8&rs=1&qlt=90&o=6&dpr=1.3&pid=3.1&rm=2" alt="Profile Icon" >
            </a>
            </div>
        </div>
    </header>
    
    
    

    <main class="main-content">
        <section class="featured-post">
            <h2 class="featured-title">WELCOME TO MY BLOG</h2>
            <p class="featured-description">Discover stories, tips, and ideas from around the world.</p>
         </section>

        <section class="recent-posts">
            <h2>Recent Posts</h2>
            <div class="post-list">
                <% blogData.forEach((blog) => {%>
                  <article class="post">
                    <h3 class="post-title"><a href="#"><%- blog.title %></a></h3>
                    <p class="post-excerpt">
                        <%- blog.content %>
                    </p>
                </article>
                <% }) %>
            
            </div>
        </section>
    </main>
    <footer class="footer">
        <div class="container">
            <p>&copy; 2025 My Blog. All Rights Reserved.</p>
        </div>
    </footer>
</body>
</html>
