<!DOCTYPE html>
<html lang="en">
<head>
    <title>MyBlog</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            margin: 0;
            padding: 0;
            display: flex;
            height: 100vh;
        }

        .main-container {
            display: grid;
            grid-template-columns: 2fr 2fr;
            gap: 20px;
            width: 100%;
            height: 100%;
            padding: 20px;
        }

        .blog-list {
            background: #fff;
            border-right: 1px solid #ddd;
            padding: 20px;
            overflow-y: auto;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        .listed-heading {
            font-size: 2rem;
            color: #131212;
            margin-bottom: 20px;
            text-align: center;
        }

        .post-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .post-box {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 20px;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .post-box:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
        }

        .post-title {
            font-size: 1.5rem;
            color: #007bff;
            margin-bottom: 10px;
        }

        .post-title a {
            text-decoration: none;
        }

        .post-title a:hover {
            color: #0056b3;
        }

        .post-excerpt {
            font-size: 1rem;
            color: #555;
            line-height: 1.5;
        }

        .container {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            padding: 40px;
            max-width: 700px;
            margin: 10 15;
            height: calc(100% - 40px);
        }

        .container h1 {
            font-size: 1.9rem;
            color: #110b0b;
            margin-bottom: 20px;
            text-align: center;
        }

        .input-box {
            margin: 15px 0;
        }

        .input-box label {
            display: block;
            font-size: 1rem;
            margin-bottom: 5px;
        }

        .input-box input, .input-box textarea {
            width: 100%;
            padding: 10px;
            font-size: 1rem;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .input-box textarea {
            height: 100px;
            resize: none;
        }

        .submit-btn {
            background-color: #007bff;
            color: #fff;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
            width: 100%;
            transition: background-color 0.3s;
        }

        .submit-btn:hover {
            background-color: #0056b3;
        }

        @media (max-width: 768px) {
            .main-container {
                flex-direction: column;
                align-items: center;
            }
        }
    </style>
</head>
<body>
    <div class="main-container">
        <!-- Blog List Section -->
        <div class="blog-list">
            <h2 class="listed-heading">ALL BLOGS</h2>
            <div class="post-list">
                <% if (blogs && blogs.length > 0) { %>
                  <% blogs.forEach((blog) => { %>
                    <div class="post-box">
                      <h3 class="post-title">
                        <a href="#"><%= blog.title || "Untitled Post" %></a>
                      </h3>
                      <p class="post-excerpt">
                        <%= blog.content || "No content available." %>
                      </p>
                    </div>
                  <% }) %>
                <% } else { %>
                  <p>No blogs available at the moment. Check back later!</p>
                <% } %>
            </div>
        </div>

        <!-- Blog Creation Form -->
        <div class="container">
            <h1>Create Your Blog</h1>
            <form action="/blog/Create" method="post">
                <div class="input-box">
                    <label for="title">Blog Title</label>
                    <input type="text" id="title" name="title" placeholder="Enter your blog title" required>
                </div>
                <div class="input-box">
                    <label for="content">Content</label>
                    <textarea id="content" name="content" placeholder="Write your blog content" required></textarea>
                </div>
                <button type="submit" class="submit-btn">Create Blog</button>
            </form>
        </div>
    </div>
</body>
</html>
